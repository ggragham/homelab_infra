---
services:
  {{ NODE_EXPORTER_SERVICE_NAME }}:
    image: prom/node-exporter:{{ NODE_EXPORTER_VERSION }}
    container_name: {{ NODE_EXPORTER_CONTAINER_NAME }}
    restart: unless-stopped
    network_mode: host
    pid: host
    command:
      - --path.rootfs=/host
    volumes:
      - /:/host:ro,rslave
